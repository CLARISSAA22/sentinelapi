# ============================================================
# SENTINELAPI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and configure values before deployment.
# NEVER commit the real .env file or real secrets to source control.

# Application Environment (production / development / testing)
FLASK_ENV=production

# Cryptographic Secret Key (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace_with_a_secure_64_character_hex_random_key_here

# Database Connection URI
# Local SQLite default: sqlite:///database/sentinelapi.db
# Cloud PostgreSQL: postgresql://user:password@hostname:5432/sentinelapi?sslmode=require
DATABASE_URL=sqlite:///database/sentinelapi.db

# Cookie & Session Security (Set to 1 when serving over HTTPS / SSL)
SESSION_COOKIE_SECURE=1

# Application Server Port (Defaults to 5000)
PORT=5000

# Scanner Concurrency & Timeout
SCAN_MAX_CONCURRENT_CHECKS=5
SSRF_REQUEST_TIMEOUT=10
